cc_library {
    name: "libinput_shim",
    srcs: [
        "android_view_KeyEvent.cpp",
        "Input.cpp",
    ],
    include_dirs: [
        "frameworks/native/include",
        "frameworks/native/libs/ui/include",
    ],
    shared_libs: [
        "libandroid_runtime",
        "libinput",
    ],
    compile_multilib: "64",
    system_ext_specific: true,
}
